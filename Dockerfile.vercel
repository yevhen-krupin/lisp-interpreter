FROM golang:1.26-alpine AS build-stage

WORKDIR /app
COPY ./server ./server
COPY ./core ./core
COPY ./server/static /server/static

WORKDIR /app/server
RUN go mod download

WORKDIR /app

WORKDIR /app/server
RUN CGO_ENABLED=0 GOOS=linux go build -o /repl

FROM alpine:3.22

WORKDIR /

COPY --from=build-stage /server/static /static
COPY --from=build-stage /repl /repl

ENTRYPOINT ["/repl"]